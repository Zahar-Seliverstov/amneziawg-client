{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AWG Client",
  "mainBinaryName": "awg-client-desktop",
  "version": "1.1.0",
  "identifier": "org.amnezia.awgclient",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../frontend run generate",
    "frontendDist": "../../frontend/.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AWG Client",
        "url": "index.html",
        "width": 1120,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Клиент AmneziaWG",
    "longDescription": "Десктопный клиент AmneziaWG: окно с интерфейсом и служба, которая поднимается с правами root через polkit и управляет туннелем.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": [
      "binaries/awg-client"
    ],
    "linux": {
      "deb": {
        "depends": [
          "polkit"
        ]
      }
    }
  }
}
